# ============================================================
# Генератор дидактических материалов и КТП по электротехнике
# Скопируйте этот файл в .env и заполните значения
# ============================================================

# --- ProxyAPI.ru (OpenAI-совместимый шлюз) ---
# Если ключ пустой — приложение работает в МОК-режиме
# (возвращает красивый пример: закон Ома, LaTeX, Mermaid)
PROXYAPI_KEY=
PROXYAPI_BASE_URL=https://api.proxyapi.ru/v1
MODEL_NAME=deepseek/deepseek-chat

# Дополнительные параметры генерации
LLM_TEMPERATURE=0.4
LLM_MAX_TOKENS=4096

# --- SMTP для email-уведомлений (опционально) ---
# Если SMTP_ENABLED=false или SMTP_HOST пустой — письма не отправляются,
# но генерация и сохранение работают как обычно
SMTP_ENABLED=false
SMTP_HOST=smtp.gmail.com
SMTP_PORT=465
SMTP_USER=teacher@gmail.com
SMTP_PASSWORD=your_app_password
SMTP_USE_SSL=true
SMTP_FROM=teacher@gmail.com

# Email преподавателя по умолчанию (для отправки готовых материалов)
TEACHER_EMAIL=teacher@example.com

# --- Приложение ---
DATABASE_URL=sqlite:///./ktp.db
APP_TITLE=Генератор дидактических материалов по электротехнике
